{
  "name": "subshell",
  "description": "Launch, attach to, and orchestrate interactive CLI coding agents from the browser.",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "start": "turbo watch dev",
    "reset:desktop": "bun scripts/reset-desktop.ts",
    "reset:client": "bun scripts/reset-client.ts",
    "dev:desktop-server": "bun scripts/desktop-dev.ts server",
    "dev:desktop-client": "bun scripts/desktop-dev.ts client",
    "dev:docs": "bun run --cwd apps/docs start",
    "dev:website": "bun run --cwd apps/website start",
    "build": "turbo run build",
    "brand:generate": "bun run --cwd brand make",
    "brand:test": "bun run --cwd brand check",
    "db:migrate:create": "cd apps/server/api && bun run db:migrate:create",
    "db:migrate:latest": "cd apps/server/api && bun run db:migrate:latest",
    "db:migrate:undo": "cd apps/server/api && bun run db:migrate:undo",
    "clean:repo": "git add --all && git reset --hard",
    "clean": "bun run clean:node_modules && bun run clean:turbo && bun run clean:dist && bun run clean:hash-runner",
    "clean:workspaces": "turbo clean",
    "clean:node_modules": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
    "clean:turbo": "find . -name node_modules -prune -o -name .turbo -type d -prune -exec rm -rf '{}' +",
    "clean:dist": "find . -name node_modules -prune -o -name dist -type d -prune -exec rm -rf '{}' +",
    "clean:hash-runner": "find . -name node_modules -prune -o -name .hashes.json -type f -delete",
    "syncpack:update": "syncpack update && syncpack fix && bun install",
    "syncpack:format": "syncpack format",
    "syncpack:lint": "syncpack lint",
    "verify-types": "turbo run verify-types --continue --",
    "lint": "turbo run lint --continue --",
    "lint:check": "turbo run lint:check --continue --",
    "lint:packages": "syncpack lint",
    "lint:licenses": "bun scripts/license-fields.ts",
    "rust:check": "bash scripts/rust-check.sh",
    "lint:licenses:fix": "bun scripts/license-fields.ts --fix",
    "lint:lockfile": "bun scripts/lockfile-workspace-versions.ts",
    "lint:lockfile:fix": "bun scripts/lockfile-workspace-versions.ts --fix",
    "lint:design": "bun scripts/design-tokens.ts",
    "lint:design:report": "bun scripts/design-tokens.ts --report",
    "lint:prose": "bun scripts/prose-dashes.ts",
    "audit:deps": "bun scripts/dep-audit.ts",
    "test": "turbo run test --continue --",
    "test:scripts": "bun test ./scripts/__tests__/",
    "test:cli": "bash scripts/cli-e2e/run.sh",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:install": "turbo run install-browsers",
    "prune:node-artifacts": "bun scripts/prune-node-artifacts.ts",
    "release:cli-node": "bun run --cwd apps/node/agent compile:release",
    "release:cli-server": "bun run --cwd apps/server/api compile:release",
    "release:desktop-server": "bun run --cwd apps/server/desktop compile:release",
    "release:desktop-client": "bun run --cwd apps/client/desktop compile:release",
    "changeset": "changeset",
    "version-packages": "changeset version && bun run lint:lockfile:fix",
    "publish-packages": "changeset publish"
  },
  "dependencies": {
    "@elysiajs/eden": "1.4.9",
    "@loglayer/elysia": "2.4.0",
    "@loglayer/transport-simple-pretty-terminal": "3.3.0",
    "loglayer": "9.4.0",
    "serialize-error": "13.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@internal/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "lefthook": "2.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "syncpack": "15.3.3",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "engineStrict": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "apps/*/*",
    "packages/*",
    "packages/plugins/*",
    "e2e",
    "brand"
  ]
}
