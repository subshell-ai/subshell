{
  "name": "@subshell-ai/plugin-netbird",
  "description": "NetBird network plugin for Subshell",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "homepage": "https://subshell.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subshell-ai/subshell.git",
    "directory": "packages/plugins/netbird"
  },
  "bugs": {
    "url": "https://github.com/subshell-ai/subshell/issues"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "hash-runner",
    "clean": "rm -rf .turbo node_modules dist .hashes.json",
    "lint": "biome check --write --unsafe src && biome format src --write && biome lint src --fix",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "test": "bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@subshell-ai/plugin-api": "workspace:*",
    "@types/bun": "1.3.14",
    "hash-runner": "4.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "subshell": {
    "apiVersion": 2,
    "id": "netbird",
    "type": "network",
    "name": "NetBird",
    "description": "Reach this server from your other devices over your NetBird network.",
    "icon": "icon.png",
    "entry": "dist/index.js",
    "detect": {
      "binaryName": "netbird",
      "envOverride": "NETBIRD_PATH",
      "knownPaths": [
        ".local/bin/netbird",
        "/usr/local/bin/netbird",
        "/opt/homebrew/bin/netbird"
      ]
    },
    "network": {
      "platforms": [
        "darwin",
        "linux"
      ],
      "exposure": "private",
      "interactiveLogin": true,
      "publishImplicit": true,
      "privileged": {
        "linux": [
          {
            "label": "Install NetBird",
            "command": "curl -fsSL https://get.netbird.io | sh",
            "docsUrl": "https://docs.netbird.io/how-to/installation"
          }
        ],
        "darwin": [
          {
            "group": "The NetBird app (recommended)",
            "label": "Install the NetBird app, then open it and log in",
            "command": "brew install --cask netbird",
            "docsUrl": "https://docs.netbird.io/how-to/installation"
          },
          {
            "group": "The command-line daemon",
            "label": "Install the NetBird daemon and its service",
            "command": "brew install netbirdio/tap/netbird && sudo netbird service install && sudo netbird service start",
            "docsUrl": "https://docs.netbird.io/how-to/installation"
          }
        ]
      },
      "labels": {
        "credential": "Setup key",
        "credentialDocsUrl": "https://docs.netbird.io/manage/peers/register-machines-using-setup-keys",
        "publish": "Use this address"
      }
    }
  }
}
