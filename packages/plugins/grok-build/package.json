{
  "name": "@subshell-ai/plugin-grok-build",
  "description": "Grok Build harness plugin for Subshell",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "homepage": "https://subshell.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subshell-ai/subshell.git",
    "directory": "packages/plugins/grok-build"
  },
  "bugs": {
    "url": "https://github.com/subshell-ai/subshell/issues"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "hash-runner",
    "clean": "rm -rf .turbo node_modules dist .hashes.json",
    "lint": "biome check --write --unsafe src && biome format src --write && biome lint src --fix",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "test": "bash \"$(git rev-parse --show-toplevel)/scripts/par-test.sh\" 4 bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@subshell-ai/plugin-api": "workspace:*",
    "@types/bun": "1.3.14",
    "hash-runner": "5.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "subshell": {
    "apiVersion": 2,
    "id": "grok-build",
    "type": "agent-harness",
    "name": "Grok Build",
    "description": "xAI\u2019s interactive coding agent",
    "entry": "dist/index.js",
    "detect": {
      "binaryName": "grok",
      "envOverride": "GROK_PATH",
      "knownPaths": [
        ".grok/bin/grok"
      ]
    },
    "install": {
      "command": "curl -fsSL https://x.ai/cli/install.sh | bash",
      "docsUrl": "https://github.com/xai-org/grok-build"
    }
  }
}
