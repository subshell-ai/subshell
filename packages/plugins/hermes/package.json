{
  "name": "@subshell-ai/plugin-hermes",
  "description": "Hermes Agent harness plugin for Subshell",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "build:dev": "hash-runner",
    "clean": "rm -rf .turbo node_modules dist .hashes.json",
    "lint": "biome check --write --unsafe src && biome format src --write && biome lint src --fix",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "test": "bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@subshell-ai/plugin-api": "workspace:*",
    "@types/bun": "1.3.14",
    "hash-runner": "4.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "subshell": {
    "apiVersion": 1,
    "id": "hermes",
    "type": "agent-harness",
    "name": "Hermes Agent",
    "description": "Nous Research's open agent CLI (interactive chat)",
    "icon": "\ud83d\udcee",
    "entry": "dist/index.js",
    "detect": {
      "binaryName": "hermes",
      "envOverride": "HERMES_PATH",
      "knownPaths": [
        ".local/bin/hermes"
      ]
    },
    "install": {
      "command": "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash",
      "docsUrl": "https://hermes-agent.nousresearch.com/docs/getting-started/installation"
    }
  }
}
