{
  "name": "@subshell-ai/plugin-opencode",
  "description": "OpenCode harness plugin for Subshell",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "homepage": "https://subshell.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subshell-ai/subshell.git",
    "directory": "packages/plugins/opencode"
  },
  "bugs": {
    "url": "https://github.com/subshell-ai/subshell/issues"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "hash-runner",
    "clean": "rm -rf .turbo node_modules dist .hashes.json",
    "lint": "biome check --write --unsafe src && biome format src --write && biome lint src --fix",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "test": "bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@subshell-ai/plugin-api": "workspace:*",
    "@types/bun": "1.3.14",
    "hash-runner": "4.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "subshell": {
    "apiVersion": 1,
    "id": "opencode",
    "type": "agent-harness",
    "name": "OpenCode",
    "description": "Open-source omnichannel agentic coding CLI (interactive TUI)",
    "icon": "✳️",
    "entry": "dist/index.js",
    "detect": {
      "binaryName": "opencode",
      "envOverride": "OPENCODE_PATH",
      "knownPaths": [
        ".opencode/bin/opencode"
      ]
    },
    "install": {
      "command": "curl -fsSL https://opencode.ai/install | bash",
      "docsUrl": "https://opencode.ai/docs/cli/"
    }
  }
}
