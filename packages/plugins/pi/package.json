{
  "name": "@subshell-ai/plugin-pi",
  "description": "pi harness plugin for Subshell",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "homepage": "https://subshell.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subshell-ai/subshell.git",
    "directory": "packages/plugins/pi"
  },
  "bugs": {
    "url": "https://github.com/subshell-ai/subshell/issues"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "hash-runner",
    "clean": "rm -rf .turbo node_modules dist .hashes.json",
    "lint": "biome check --write --unsafe src && biome format src --write && biome lint src --fix",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "test": "bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@subshell-ai/plugin-api": "workspace:*",
    "@types/bun": "1.3.14",
    "hash-runner": "4.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "files": ["dist", "icon.svg"],
  "publishConfig": {
    "access": "public"
  },
  "subshell": {
    "apiVersion": 2,
    "id": "pi",
    "type": "agent-harness",
    "name": "pi",
    "description": "Minimal, extensible agent harness from pi.dev (interactive TUI)",
    "icon": "icon.svg",
    "entry": "dist/index.js",
    "detect": {
      "binaryName": "pi",
      "envOverride": "PI_PATH",
      "knownPaths": [
        ".bun/bin/pi"
      ]
    },
    "install": {
      "command": "curl -fsSL https://pi.dev/install.sh | sh",
      "docsUrl": "https://pi.dev/docs"
    }
  }
}
