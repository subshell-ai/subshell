{
  "name": "@internal/node-admin",
  "description": "Shared node-admin UI: the cards, hooks and primitives for operating a Subshell node — used by the control plane's Nodes pages and by the node's own loopback dashboard",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "build:dev": "hash-runner",
    "clean": "rm -rf .turbo node_modules dist .hashes.json",
    "lint": "biome check --write --unsafe src && biome format src --write && biome lint src --fix",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "test": "bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@internal/subshell-protocol": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.32.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.13",
    "@internal/tsconfig": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.30",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "hash-runner": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.30",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
