{
  "extends": "@internal/tsconfig/tsconfig.json",
  "include": [
    "src/**/*",
    "inline.ts",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "bun"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
