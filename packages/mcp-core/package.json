{
  "name": "@internal/mcp-core",
  "description": "The `subshell mcp` stdio server shared by the server binary's mcp subcommand and the agent's mcp subcommand",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "build:dev": "hash-runner",
    "clean": "rm -rf .turbo node_modules dist .hashes.json",
    "lint": "biome check --write --unsafe src && biome format src --write && biome lint src --fix",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "test": "bash \"$(git rev-parse --show-toplevel)/scripts/par-test.sh\" 4 bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@internal/subshell-protocol": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "hash-runner": "5.0.0",
    "tsdown": "0.22.14"
  }
}
