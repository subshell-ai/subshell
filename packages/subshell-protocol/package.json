{
  "name": "@internal/subshell-protocol",
  "description": "Subshell contract shared by the backend and frontend: WebSocket frames and upload limits",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-link-crypto": {
      "types": "./dist/node-link-crypto.d.ts",
      "import": "./dist/node-link-crypto.js"
    },
    "./release-artifacts": {
      "types": "./dist/release-artifacts.d.ts",
      "import": "./dist/release-artifacts.js"
    },
    "./release-signature": {
      "types": "./dist/release-signature.d.ts",
      "import": "./dist/release-signature.js"
    },
    "./service-test-safety": {
      "types": "./dist/service-test-safety.d.ts",
      "import": "./dist/service-test-safety.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "build:dev": "hash-runner",
    "clean": "rm -rf .turbo node_modules dist .hashes.json",
    "lint": "biome check --write --unsafe src && biome format src --write && biome lint src --fix",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "test": "bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "cbor2": "2.3.0",
    "jose": "6.2.9",
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "@types/sprintf-js": "1.1.4",
    "@internal/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "hash-runner": "4.0.0",
    "tsdown": "0.22.14"
  }
}
