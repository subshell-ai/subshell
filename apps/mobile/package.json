{
  "name": "@internal/mobile",
  "description": "Native iOS/Android companion for mote — monitors sessions and rings when one waits for you",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform android --output-dir dist",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "clean": "rm -rf .turbo node_modules dist .expo",
    "lint": "biome check --no-errors-on-unmatched --write --unsafe src app scripts",
    "lint:check": "biome check --no-errors-on-unmatched src app scripts",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src app scripts",
    "test": "bun test --pass-with-no-tests",
    "verify-types": "tsc --noEmit",
    "harness:m1": "bun scripts/m1-transport-harness.ts"
  },
  "dependencies": {
    "@internal/backend-errors": "workspace:*",
    "@internal/session-protocol": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "5.101.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "expo": "57.0.18",
    "expo-clipboard": "57.0.1",
    "expo-constants": "57.0.16",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.16",
    "expo-haptics": "57.0.2",
    "expo-linking": "57.0.8",
    "expo-local-authentication": "57.0.2",
    "expo-notifications": "57.0.15",
    "expo-router": "57.0.17",
    "expo-secure-store": "57.0.2",
    "expo-status-bar": "57.0.1",
    "react": "19.2.8",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  }
}
