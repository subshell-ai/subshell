{
  "name": "@internal/node",
  "description": "subshell \u2014 node client daemon: enrolls with the control plane and executes signed commands",
  "version": "0.5.1",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "build:dev": "hash-runner",
    "clean": "rm -rf .turbo node_modules dist .hashes.json",
    "lint": "biome check --write --unsafe src && biome format src --write && biome lint src --fix",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "test": "bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit",
    "compile": "bun build --compile --bytecode --minify --sourcemap ./src/main.ts --outfile ./dist/subshell",
    "compile:release": "bun run src/scripts/release.ts"
  },
  "dependencies": {
    "@internal/backend-errors": "workspace:*",
    "@internal/mcp-core": "workspace:*",
    "@internal/pane-runtime": "workspace:*",
    "@internal/subshell-protocol": "workspace:*",
    "@subshell-ai/plugin-api": "workspace:*",
    "jose": "6.2.9",
    "loglayer": "9.4.0"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "hash-runner": "4.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  }
}
