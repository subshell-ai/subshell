SERVER_PORT=3080
HOST=127.0.0.1
# SQLite file. Tests ignore this and always use an in-memory database.
DATABASE_PATH=./data/mote.db
# Defaults to http://localhost:<SERVER_PORT>. Its origin is always trusted.
APP_BASE_URL=http://localhost:3080

# ADDITIONAL origins allowed to call the API with credentials (dev Vite server,
# :5174). The instance's own origins need no listing: both loopback spellings
# of SERVER_PORT, plus HOST when it is a concrete bind address.
TRUSTED_ORIGINS=http://localhost:5174,http://localhost:5173

# Auth signing secret — REQUIRED in production (>= 32 chars).
BETTER_AUTH_SECRET=
