{
  "name": "@internal/desktop-server",
  "description": "Subshell Server — a Tauri shell that installs, runs and manages a local subshell-server",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf src-tauri/target src-tauri/binaries/subshell-server-bundled-* ui/dist",
    "compile": "tauri build --debug",
    "dev:app": "tauri dev",
    "dev:ui": "vite",
    "icons": "tauri icon src-tauri/icons/app-icon.png && rm -rf src-tauri/icons/android src-tauri/icons/ios src-tauri/icons/icon.ico src-tauri/icons/Square*Logo.png src-tauri/icons/StoreLogo.png",
    "lint": "biome check --write --unsafe src ui",
    "lint:check": "biome check src ui",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src ui",
    "test": "bun test --path-ignore-patterns \"**/ui/**\" src && cd ui && bun test",
    "verify-types": "tsc --project tsconfig.json --noEmit && tsc --project ui/tsconfig.json --noEmit",
    "compile:release": "bun run src/scripts/release.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@internal/assistant": "workspace:*",
    "@internal/subshell-protocol": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.13",
    "@internal/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1"
  }
}
