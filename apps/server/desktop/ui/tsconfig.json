{
  "extends": "@internal/tsconfig/tsconfig.json",
  "include": ["src/**/*", "../vite.config.ts"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["bun", "react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true
  }
}
