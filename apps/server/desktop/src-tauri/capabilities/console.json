{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "console",
  "description": "The bundled server-control page, and the ONLY surface allowed to drive the subshell-server CLI. That is why it is a separate window from the one showing the server's own SPA: the boundary is the window and its origin, not a convention.",
  "local": true,
  "windows": [
    "console"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "allow-desktop-probe",
    "allow-desktop-logs",
    "allow-desktop-install-server",
    "allow-desktop-setup",
    "allow-desktop-install-tmux",
    "allow-desktop-install-agent",
    "allow-desktop-init",
    "allow-desktop-service",
    "allow-desktop-set-server-bin",
    "allow-desktop-open-main",
    "allow-desktop-open-path",
    "allow-desktop-open-control-plane",
    "allow-desktop-open-tmux-docs",
    "opener:allow-reveal-item-in-dir",
    "allow-desktop-settings",
    "allow-desktop-set-close-to-tray"
  ]
}
