{
  "name": "@internal/server",
  "description": "",
  "version": "0.7.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config-values": {
      "types": "./dist/commands/config-values.d.ts",
      "import": "./dist/commands/config-values.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "db:migrate:create": "bunx --bun kysely migrate make",
    "db:migrate:latest": "bunx --bun kysely migrate latest",
    "db:migrate:undo": "bunx --bun kysely migrate down",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "compile": "bun build --compile --target=bun --bytecode --minify --sourcemap ./src/index.ts --outfile ./dist/subshell-server",
    "compile:release": "bun run src/scripts/release.ts",
    "clean": "rm -rf .turbo node_modules dist",
    "dev": "bun run --watch ./src/index.ts",
    "lint": "biome check --no-errors-on-unmatched --write --unsafe src",
    "lint:check": "biome check --no-errors-on-unmatched src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "prod": "bun run ./dist/index.js",
    "test": "TMUX_TMPDIR=$(mktemp -d /tmp/subshell-test-tmux-XXXXXX) bun test --timeout 30000 src",
    "verify-types": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.1",
    "@better-auth/passkey": "1.7.1",
    "@clack/prompts": "1.8.1",
    "@dotenvx/dotenvx": "2.21.0",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "@internal/backend-errors": "workspace:*",
    "@internal/mcp-core": "workspace:*",
    "@internal/pane-runtime": "workspace:*",
    "@internal/subshell-protocol": "workspace:*",
    "@loglayer/elysia": "2.4.0",
    "@loglayer/transport-simple-pretty-terminal": "3.3.0",
    "better-auth": "1.7.1",
    "better-auth-ui": "3.2.27",
    "dotenv": "17.4.2",
    "elysia": "1.4.29",
    "env-var": "7.5.0",
    "expo-server-sdk": "7.2.0",
    "file-type": "22.0.2",
    "jose": "6.2.9",
    "kysely": "0.29.5",
    "kysely-bun-sqlite-dialect": "1.0.0",
    "loglayer": "9.4.0",
    "nanoid": "6.0.1",
    "sanitize-filename": "1.6.4",
    "serialize-error": "13.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@elysiajs/eden": "1.4.9",
    "@internal/tsconfig": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@turbo/gen": "2.10.11",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/web-push": "3.6.4",
    "jiti": "2.7.0",
    "kysely-ctl": "0.21.0",
    "tsc-alias": "1.9.2",
    "typescript": "7.0.2"
  }
}
