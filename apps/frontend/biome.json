{
  "root": false,
  "extends": ["../../biome.json"],
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "unsafe",
          "options": {
            "attributes": ["class", "className"],
            "functions": ["clsx", "cva", "cn", "tw"]
          }
        }
      }
    }
  }
}
