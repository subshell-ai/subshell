# Copy to .env.local (gitignored) and adjust for your machine.

# Extra hostnames the Vite dev server may be reached under, comma-separated.
# Needed only when a reverse proxy forwards to :5174 — Vite rejects requests
# whose Host header is not localhost unless listed here.
# Example: DEV_ALLOWED_HOSTS=mote.example.com
DEV_ALLOWED_HOSTS=
