{
  "name": "@internal/website",
  "description": "Public marketing site for Subshell: static export at subshell.sh",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run copy-releases && next dev -p 3401",
    "copy-releases": "bun scripts/prepare-data.ts",
    "prebuild": "bun run copy-releases",
    "build": "next build",
    "preview": "bunx wrangler dev",
    "clean": "rm -rf .turbo .next out data node_modules/.cache",
    "lint": "biome check --no-errors-on-unmatched --write --unsafe app lib components scripts",
    "lint:check": "biome check --no-errors-on-unmatched app lib components scripts",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged app lib components scripts",
    "test": "bun test",
    "verify-types": "tsc --noEmit"
  },
  "dependencies": {
    "@internal/subshell-protocol": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.13",
    "@internal/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
