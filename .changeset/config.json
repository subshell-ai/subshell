{
  "$schema": "https://unpkg.com/@changesets/config@3.1.1/schema/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "subshell-ai/subshell"
    }
  ],
  "access": "restricted",
  "baseBranch": "main",
  "ignore": [
