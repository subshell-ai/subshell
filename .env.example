# docker-compose settings — copy to .env (gitignored) and fill in.

# REQUIRED: signs session cookies (>= 32 chars). Use the SAME value an
# existing instance used and browser sessions survive the move.
BETTER_AUTH_SECRET=

# The URL users actually open; its origin is trusted automatically
# (needed for a reverse-propped deployment).
APP_BASE_URL=http://localhost:3080

# Optional host-path overrides for the bind mounts.
# SUBSHELL_DATA_HOST_DIR=$HOME/.config/subshell
# PROJECTS_DIR=$HOME/projects
# CLAUDE_BIN=$HOME/.local/bin/claude
